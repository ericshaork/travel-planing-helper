USE_MOCK_AI=true
USE_MOCK_POI=true
USE_MOCK_ROUTE=true
USE_MOCK_WEATHER=true

AI_PROVIDER=mock
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=qwen-plus
AI_TIMEOUT_MS=120000

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=qwen-plus
LLM_TIMEOUT_MS=120000

POI_PROVIDER=mock
ROUTE_PROVIDER=mock
WEATHER_PROVIDER=mock

AMAP_API_KEY=
NEXT_PUBLIC_AMAP_JS_KEY=
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=

QWEATHER_BASE_URL=
QWEATHER_API_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=
SUPABASE_SERVICE_ROLE_KEY=
WANDERLY_ENABLE_DEV_GUEST_PROJECTS=true

# AI
# - Keep USE_MOCK_AI=true if you want the mock conversation and trip providers.
# - For real conversation or trip AI, set USE_MOCK_AI=false.
# - Preferred new variables: AI_PROVIDER / AI_BASE_URL / AI_API_KEY / AI_MODEL / AI_TIMEOUT_MS.
# - Supported AI_PROVIDER values: mock, qwen, deepseek, openai-compatible.
# - If AI_* variables are empty, the server falls back to LLM_* variables.
# - Only store API keys in .env.local or your deployment secret manager.

# Frontend AMap JS SDK
# - NEXT_PUBLIC_AMAP_JS_KEY is exposed to the browser.
# - NEXT_PUBLIC_AMAP_SECURITY_JS_CODE is only needed when the JS key uses a security code.

# Server-side providers
# - AMAP_API_KEY is only for server-side POI and route requests.
# - QWEATHER_API_KEY and QWEATHER_BASE_URL are only for server-side weather requests.

# Supabase
# - NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY can be exposed to the frontend.
# - NEXT_PUBLIC_SITE_URL should be your canonical app origin, e.g. https://your-site.netlify.app .
# - Magic link emails use NEXT_PUBLIC_SITE_URL first, then fall back to the current browser origin in development.
# - SUPABASE_SERVICE_ROLE_KEY must stay server-side only.
# - WANDERLY_ENABLE_DEV_GUEST_PROJECTS is a local-development-only bypass for /create Copilot testing.
# - Set it to false to restore the normal login requirement for TravelProject APIs in development.
