{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travel-content-pipeline.local/schemas/explore_archive_schema_v1.json",
  "title": "Travel Content Pipeline Explore Archive Schema v1",
  "description": "Canonical schema for Explore travel plan JSON generated by travel-content-pipeline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "slug",
    "title",
    "summary",
    "city",
    "trip_type",
    "days",
    "budget",
    "pace",
    "tags",
    "image_prompt",
    "daily_itinerary",
    "pois",
    "food"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Stable unique identifier for one plan."
    },
    "slug": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Lowercase slug used for indexing and stable references."
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "description": "Readable Chinese title with city scene and trip angle."
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "description": "Short Chinese summary describing who the plan is for and why it is worth taking."
    },
    "city": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "name",
        "region_name"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "region_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trip_type": {
      "type": "string",
      "enum": [
        "family",
        "couple",
        "student",
        "solo"
      ]
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "note"
      ],
      "properties": {
        "level": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "pace": {
      "type": "string",
      "enum": [
        "slow",
        "balanced",
        "dense"
      ]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "image_prompt": {
      "type": "string",
      "minLength": 1,
      "description": "Prompt used for later image generation only, not reader-facing copy."
    },
    "daily_itinerary": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/dailyItineraryItem"
      }
    },
    "pois": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/poi"
      }
    },
    "food": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/food"
      }
    }
  },
  "$defs": {
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_block",
        "description",
        "poi_refs",
        "food_refs"
      ],
      "properties": {
        "time_block": {
          "type": "string",
          "enum": [
            "morning",
            "afternoon",
            "evening"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "poi_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "food_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dailyItineraryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "title",
        "summary",
        "activities"
      ],
      "properties": {
        "day": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "activities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/activity"
          }
        }
      }
    },
    "poi": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "district",
        "type",
        "reason",
        "recommended_duration_minutes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "district": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "recommended_duration_minutes": {
          "type": "integer",
          "minimum": 30
        }
      }
    },
    "food": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "district",
        "category",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "district": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
